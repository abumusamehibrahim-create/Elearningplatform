@model ELearningPlatform.Models.Video
@{
    ViewData["Title"] = Model.Title;

    // رابط HLS القادم من الـ Controller
    var streamUrl = ViewBag.VideoUrl;
}

<div class="alert alert-info m-3">
    <h5>🎬 معلومات الفيديو (Bunny Stream):</h5>
    <p><strong>Video ID:</strong> @Model.Id</p>
    <p><strong>Bunny Video ID:</strong> @Model.BunnyVideoId</p>
    <p><strong>CDN Hostname:</strong> @Model.BunnyCDNHostname</p>
    <p><strong>Stream URL:</strong> @streamUrl</p>
</div>

<div style="background:#000;">
    <div class="container px-0">

        <video id="videoPlayer"
               controls
               width="100%"
               style="max-height:70vh;"
               controlsList="nodownload"
               oncontextmenu="return false;">
            متصفحك لا يدعم تشغيل الفيديو.
        </video>

        <!-- HLS.js -->
        <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>

        <script>
            const video = document.getElementById('videoPlayer');
            const url = "@streamUrl";

            console.log("🔗 Loading HLS URL:", url);

            if (!url || url.trim() === "") {
                console.error("❌ Stream URL is empty");
            }

            if (Hls.isSupported()) {
                const hls = new Hls({
                    debug: true
                });

                hls.loadSource(url);
                hls.attachMedia(video);

                hls.on(Hls.Events.MANIFEST_PARSED, function () {
                    console.log("✔ Manifest Loaded");
                });

                hls.on(Hls.Events.ERROR, function (event, data) {
                    console.error("❌ HLS.js error:", data);
                });

            } else if (video.canPlayType("application/vnd.apple.mpegurl")) {
                video.src = url; // Safari
            } else {
                console.error("❌ HLS not supported in this browser");
            }

            video.addEventListener("error", () => {
                console.error("❌ Video element error:", video.error);
            });

            video.addEventListener("loadstart", () => console.log("⏳ Loading Bunny Stream..."));
            video.addEventListener("canplay", () => console.log("✔ Bunny Stream Ready"));
        </script>

    </div>
</div>
