@model ELearningPlatform.Models.Video
<link rel="stylesheet" href="~/css/watermark.css" />

@{
    ViewData["Title"] = Model.Title;

    var streamUrl = ViewBag.VideoUrl;
    var watermark = ViewBag.Watermark;   // ⭐ أضفنا هذا
}

<div class="alert alert-info m-3">
    <h5>🎬 معلومات الفيديو (Bunny Stream):</h5>
   <!-- <p><strong>Video ID:</strong> XModel.Id</p>
    <p><strong>Bunny Video ID:</strong> XModel.BunnyVideoId</p>
    <p><strong>Stream URL:</strong> XstreamUrl</p>
    -->
   <!-- Xif (ViewBag.DebugInfo != null)
    {
        <div class="alert alert-warning m-3">
            <h5>🔧 Debug Info:</h5>
            <ul>
               Xforeach (var item in ViewBag.DebugInfo)
                {
                    <li>Xitem</li>
                }
            </ul>
        </div>
    }-->
</div>

<div id="video-wrapper">
    <div id="watermark">
        @ViewBag.Watermark
    </div>

    <div class="container px-0">
              <video id="videoPlayer"
               controls
               width="100%"
               style="max-height:70vh;"
               controlsList="nodownload"
               oncontextmenu="return false;"
               onclick="toggleFullscreen()">
            متصفحك لا يدعم تشغيل الفيديو.
        </video>

        <!-- HLS.js -->
        <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>

        <script>
            const video = document.getElementById('videoPlayer');
            const url = "@streamUrl";

            console.log("Loading URL:", url);

            if (!url || url.trim() === "") {
                console.error("❌ Stream URL is empty");
            }

            if (Hls.isSupported()) {
                const hls = new Hls({
                    debug: true,
                    xhrSetup: function (xhr) {
                        xhr.withCredentials = false;
                    }
                });

                hls.loadSource(url);
                hls.attachMedia(video);

                hls.on(Hls.Events.MANIFEST_PARSED, function () {
                    console.log("✔ HLS Manifest Loaded");
                });

                hls.on(Hls.Events.ERROR, function (event, data) {
                    console.error("❌ HLS.js error:", data);
                });
            }
            else if (video.canPlayType("application/vnd.apple.mpegurl")) {
                video.src = url; // Safari
            }
            else {
                console.error("❌ HLS not supported in this browser");
            }

            video.addEventListener("error", () => {
                console.error("❌ Video element error:", video.error);
            });

            video.addEventListener("loadstart", () => console.log("⏳ Loading Bunny Stream..."));
            video.addEventListener("canplay", () => console.log("✔ Bunny Stream Ready"));
               </script>
        <script>
            function toggleFullscreen() {
                const wrapper = document.getElementById('video-wrapper');
                if (!document.fullscreenElement) {
                    wrapper.requestFullscreen();
                }
            }
        </script>

    </div>
</div>
