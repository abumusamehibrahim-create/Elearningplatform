@model WorksheetViewModel

<h2 class="fw-bold text-danger mb-4">
    <i class="fas fa-file-alt me-2"></i> أوراق العمل: @Model.Title
</h2>

@if (Model.WorksheetFiles == null || !Model.WorksheetFiles.Any())
{
    <div class="alert alert-warning">
        لا توجد أوراق عمل لهذا الفيديو حالياً.
    </div>
}
else
{
    @foreach (var file in Model.WorksheetFiles)
    {
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-danger text-white">
                <i class="fas fa-file-pdf me-2"></i> @file.FileName
            </div>

            <div class="card-body p-0">
                <iframe src="/Worksheet/ViewPdfBunny/@file.Id"
                        style="width:100%; height:700px; border:none;"
                        class="worksheet-frame">
                </iframe>
            </div>

            @if (file.AllowDownload || User.IsInRole("Admin"))
            {
                <div class="card-footer text-end">
                    <a asp-action="DownloadBunny" asp-route-id="@file.Id"
                       class="btn btn-sm btn-outline-danger">
                        <i class="fas fa-download"></i> تحميل
                    </a>
                </div>
            }
        </div>
    }
}
